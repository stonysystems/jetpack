+            // Jetpack signal: this server leads ZAB epoch `epoch` (the Jetpack view
+            // id). Append "zookeeper:primary_elected term=<epoch>" (plus
+            // " loc=<JM_SIGNAL_LOC>" if that env var names the co-located Jetpack
+            // replica's locale, for signal files shared by several replicas) to
+            // $JM_SIGNAL_DIR/JM_Jetpack_<JM_SIGNAL_HOST>, then wait until the
+            // Jetpack replica acks "jetpack:leader_paused term=<epoch>" (its fast
+            // path is stopped for this epoch). This blocks the leader broadcast
+            // setup thread but does NOT affect the quorum follower handler
+            // threads which run independently.
+            try {
+                String signalDir = System.getenv("JM_SIGNAL_DIR");
+                if (signalDir == null || signalDir.isEmpty()) {
+                    signalDir = "/tmp";
+                }
+                String signalHost = System.getenv("JM_SIGNAL_HOST");
+                if (signalHost == null || signalHost.isEmpty()) {
+                    signalHost = "0.0.0.0";
+                }
+                String signalPath = signalDir + "/JM_Jetpack_" + signalHost;
+                String signal = "zookeeper:primary_elected term=" + epoch;
+                String signalLoc = System.getenv("JM_SIGNAL_LOC");
+                if (signalLoc != null && !signalLoc.isEmpty()) {
+                    signal += " loc=" + signalLoc;
+                }
+                try (PrintWriter pw = new PrintWriter(new FileWriter(signalPath, true))) {
+                    pw.println(signal);
+                }
+                LOG.info("Jetpack signal written: {} -> {}", signal, signalPath);
+
+                // Wait for the Jetpack ack of this epoch.
+                // Timeout after 5 seconds to avoid deadlock.
+                String needle = "jetpack:leader_paused term=" + epoch;
+                long deadline = System.currentTimeMillis() + 5000;
+                boolean observed = false;
+                while (System.currentTimeMillis() < deadline) {
+                    try (BufferedReader br = new BufferedReader(new FileReader(signalPath))) {
+                        String line;
+                        while ((line = br.readLine()) != null) {
+                            if (needle.equals(line)) {
+                                observed = true;
+                                break;
+                            }
+                        }
+                    } catch (IOException ignored) {}
+                    if (observed) break;
+                    Thread.sleep(1);
+                }
+                if (observed) {
+                    LOG.info("Jetpack {} observed, resuming request processing", needle);
+                } else {
+                    LOG.warn("Timed out waiting for Jetpack {}, resuming anyway", needle);
+                }
+            } catch (Exception e) {
+                LOG.warn("Failed to write Jetpack signal file", e);
+            }
+
