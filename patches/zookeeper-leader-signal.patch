+            // Jetpack signal: notify that ZooKeeper leader election is complete.
+            // Write "zookeeper:primary_elected" to /tmp/JM_Jetpack_<host> so
+            // Jetpack servers can detect the new leader and trigger recovery.
+            // Then wait for Jetpack to confirm fast path is stopped.  This
+            // blocks the leader broadcast setup thread but does NOT affect the
+            // quorum follower handler threads which run independently.
+            try {
+                String signalDir = System.getenv("JM_SIGNAL_DIR");
+                if (signalDir == null || signalDir.isEmpty()) {
+                    signalDir = "/tmp";
+                }
+                String signalHost = System.getenv("JM_SIGNAL_HOST");
+                if (signalHost == null || signalHost.isEmpty()) {
+                    signalHost = "0.0.0.0";
+                }
+                String signalPath = signalDir + "/JM_Jetpack_" + signalHost;
+                try (PrintWriter pw = new PrintWriter(new FileWriter(signalPath, true))) {
+                    pw.println("zookeeper:primary_elected");
+                }
+                LOG.info("Jetpack signal written: zookeeper:primary_elected -> {}", signalPath);
+
+                // Wait for Jetpack to confirm fast path is stopped.
+                // Timeout after 5 seconds to avoid deadlock.
+                String needle = "jetpack:fastpath_stopped";
+                long deadline = System.currentTimeMillis() + 5000;
+                boolean observed = false;
+                while (System.currentTimeMillis() < deadline) {
+                    try (BufferedReader br = new BufferedReader(new FileReader(signalPath))) {
+                        String line;
+                        while ((line = br.readLine()) != null) {
+                            if (needle.equals(line)) {
+                                observed = true;
+                                break;
+                            }
+                        }
+                    } catch (IOException ignored) {}
+                    if (observed) break;
+                    Thread.sleep(1);
+                }
+                if (observed) {
+                    LOG.info("Jetpack fastpath_stopped observed, resuming request processing");
+                } else {
+                    LOG.warn("Timed out waiting for Jetpack fastpath_stopped, resuming anyway");
+                }
+            } catch (Exception e) {
+                LOG.warn("Failed to write Jetpack signal file", e);
+            }
+
