+
+// jetpackApplyReadOnlyOption selects raft's linearizable-read strategy from the
+// ETCD_READ_ONLY_OPTION environment variable. Upstream etcd leaves
+// raft.Config.ReadOnlyOption at its zero value, ReadOnlySafe (ReadIndex,
+// quorum-confirmed). Setting ETCD_READ_ONLY_OPTION=lease selects
+// ReadOnlyLeaseBased, which answers linearizable reads from the leader's lease
+// without the ReadIndex round trip. Any other value falls back to safe.
+func jetpackApplyReadOnlyOption(c *raft.Config, lg *zap.Logger) {
+	switch strings.ToLower(strings.TrimSpace(os.Getenv("ETCD_READ_ONLY_OPTION"))) {
+	case "", "safe":
+		c.ReadOnlyOption = raft.ReadOnlySafe
+	case "lease", "lease-based", "leasebased":
+		c.ReadOnlyOption = raft.ReadOnlyLeaseBased
+		if lg != nil {
+			lg.Warn("ETCD_READ_ONLY_OPTION=lease: using lease-based linearizable reads (non-default)")
+		}
+	default:
+		if lg != nil {
+			lg.Warn("unrecognized ETCD_READ_ONLY_OPTION; falling back to safe (ReadIndex)",
+				zap.String("value", os.Getenv("ETCD_READ_ONLY_OPTION")))
+		}
+		c.ReadOnlyOption = raft.ReadOnlySafe
+	}
+}
