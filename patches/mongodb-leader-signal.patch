--- a/src/mongo/db/repl/replication_coordinator_impl.cpp
+++ b/src/mongo/db/repl/replication_coordinator_impl.cpp
@@ -37,4 +37,7 @@
 #include <algorithm>
+#include <chrono>
+#include <cstdlib>
 #include <fmt/format.h>
+#include <fstream>
 #include <functional>
 #include <limits>
@@ -1438,4 +1441,73 @@
     LOGV2(21331,
           "Transition to primary complete; database writes are now permitted",
           "term"_attr = _termShadow.load());
+
+    // Jetpack signal: this node is now the primary of term T, the Jetpack view
+    // id. Append "mongo:primary_elected term=<T>" (plus " loc=<JM_SIGNAL_LOC>"
+    // if that env var names the co-located Jetpack replica's locale, for
+    // signal files shared by several replicas) to
+    // $JM_SIGNAL_DIR/JM_Jetpack_<JM_SIGNAL_HOST> so that Jetpack replica
+    // triggers its recovery for term T.
+    {
+        const long long jetpackTerm = _termShadow.load();
+        const char* signalDir = std::getenv("JM_SIGNAL_DIR");
+        std::string dir = (signalDir && *signalDir) ? signalDir : "/tmp";
+        const char* signalHost = std::getenv("JM_SIGNAL_HOST");
+        std::string host = (signalHost && *signalHost) ? signalHost : "0.0.0.0";
+        std::string signalPath = dir + "/JM_Jetpack_" + host;
+        std::string signal = "mongo:primary_elected term=" + std::to_string(jetpackTerm);
+        const char* signalLoc = std::getenv("JM_SIGNAL_LOC");
+        if (signalLoc && *signalLoc) {
+            signal += std::string(" loc=") + signalLoc;
+        }
+        std::ofstream out(signalPath, std::ios::app);
+        if (out.is_open()) {
+            out << signal << "\n";
+            out.flush();
+            LOGV2(9999901,
+                  "Jetpack signal written",
+                  "signal"_attr = signal,
+                  "path"_attr = signalPath);
+        } else {
+            LOGV2_WARNING(9999902,
+                          "Failed to write Jetpack signal file",
+                          "path"_attr = signalPath);
+        }
+
+        // Wait for the Jetpack ack of this term, "jetpack:leader_paused
+        // term=<T>" (its fast path is stopped), before allowing write traffic.
+        // This blocks the primary step-up thread but does NOT affect heartbeat
+        // or replication threads which run independently.
+        // Timeout after 5 seconds to avoid deadlock if Jetpack is unavailable.
+        const std::string needle = "jetpack:leader_paused term=" + std::to_string(jetpackTerm);
+        auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+        bool observed = false;
+        while (std::chrono::steady_clock::now() < deadline) {
+            std::ifstream in(signalPath);
+            if (in.is_open()) {
+                std::string line;
+                while (std::getline(in, line)) {
+                    if (line == needle) {
+                        observed = true;
+                        break;
+                    }
+                }
+            }
+            if (observed) break;
+            std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        }
+        if (observed) {
+            LOGV2(9999903,
+                  "Jetpack leader_paused observed, resuming request processing",
+                  "term"_attr = jetpackTerm,
+                  "path"_attr = signalPath);
+        } else {
+            LOGV2_WARNING(9999904,
+                          "Timed out waiting for Jetpack leader_paused, "
+                          "resuming request processing anyway",
+                          "term"_attr = jetpackTerm,
+                          "path"_attr = signalPath);
+        }
+    }
+
     _externalState->startNoopWriter(_getMyLastAppliedOpTime_inlock());
