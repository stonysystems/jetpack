states/
.git
**/.git
**/.gitignore

# Big build outputs / caches
**/target
**/build
# Keep mongo-c-driver CMake modules required by third_party/mongo-c-driver/CMakeLists.txt.
!third_party/mongo-c-driver/build
!third_party/mongo-c-driver/build/cmake
!third_party/mongo-c-driver/build/cmake/**
**/dist
**/.cache
**/__pycache__
**/*.log

# Node / Python
**/node_modules
**/.venv
**/venv

# Common “huge stuff” (adjust to your repo)
data/
datasets/
results/
artifacts/
tmp/
out/
logs/

# Large archives/images
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.zip
**/*.7z
**/*.iso
**/*.img
**/*.qcow2
